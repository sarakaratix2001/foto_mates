# Copy to .env and fill in your own values. .env is ignored by git.
# Keep the /v1 suffix on the URL. Inside a container, localhost means the
# container itself: use host.docker.internal to reach a server on your machine.
FOTOMATES_OCR_URL=http://your-ocr-host:28000/v1
FOTOMATES_OCR_MODEL=your-model-name
FOTOMATES_OCR_API_KEY=EMPTY

FOTOMATES_HOST=127.0.0.1
FOTOMATES_PORT=8081
