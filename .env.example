# FotoMates settings. Copy to .env and fill in the three server lines; every other line
# shows the code's default, so it can stay commented out unless you want another value.

# ---------------------------------------------------------------------------------------
# Reading: the model server and how a photo is sent to it
# ---------------------------------------------------------------------------------------
# REQUIRED. The model server's OpenAI-compatible URL, ending in /v1; several separated by commas.
FOTOMATES_OCR_URL=http://model-server:8080/v1
# REQUIRED. The model's name on that server.
FOTOMATES_OCR_MODEL=qwen3.5-122b
# REQUIRED by the server. Its API key; EMPTY when the server needs none (the code's default is EMPTY).
FOTOMATES_OCR_API_KEY=EMPTY

# The model's name shown in logs and on the web page (default: FOTOMATES_OCR_MODEL).
# FOTOMATES_OCR_LABEL=
# Extra model choices m1, m2, ...: label|url|model[|workers], separated by ';'.
# FOTOMATES_MODELS=
# Which prompt reads the photos: compact, v2 (five lines, CELLS for every meter, QUALITY 0-10), v3 (v2 with
# DECIMALS on digital displays, OFF and a SOURCE line) or v4 (v3 without READING, TYPE D|M: a shorter answer);
# any other value is an error. v3 and v4 are not the default until their test passes.
# FOTOMATES_PROMPT=v2
# v4 only: 0 writes CELLS without spaces (only when the tokenizer still gives one token per digit).
# FOTOMATES_V4_CELLS_SPACES=1
# Longest answer the model may write, in tokens.
# FOTOMATES_READ_MAX_TOKENS=112
# Shorter side, in pixels, a photo is enlarged to before it is read; 0 sends it at its own size.
# FOTOMATES_MIN_SIDE=480
# A photo scored under this is read once more, enlarged (production value).
# FOTOMATES_REREAD_BELOW=0.7
# How much that second read enlarges the photo; 1 turns the re-read off (production value).
# FOTOMATES_REREAD_SCALE=3
# Crop first: every photo is first read cut to its display (the box asked in a request of its own),
# kept when its confidence is FOTOMATES_REREAD_BELOW or more; else the whole photo is read too (and
# at REREAD_SCALE when still unsure) and the most confident read is kept. 0: the whole photo first.
# FOTOMATES_CROP_FIRST=1
# How the read after an unsure whole photo is made: enlarge (the whole photo at REREAD_SCALE) or crop
# (the whole-photo read also gives a BOX around the display; the next read cuts that box out, with
# FOTOMATES_THIRD_MARGIN, and enlarges it). Default: crop with FOTOMATES_CROP_FIRST=1, else enlarge.
# FOTOMATES_REREAD_MODE=crop
# The margin of that cut (with crop first), wider than FOTOMATES_CROP_MARGIN.
# FOTOMATES_THIRD_MARGIN=0.5
# 0: a photo whose first read gave no digits (NO METER, UNREADABLE, BLANK) is not read again.
# FOTOMATES_REREAD_EMPTY=1
# 1: a read with fewer cells than the contract's last confident AI read is read once more, told the count.
# FOTOMATES_CELL_HISTORY=0
# The box request: json (as before) or numbers (four integers, a quarter of the answer tokens).
# FOTOMATES_BOX_ANSWER=json
# Shorter side the box request's photo is enlarged to; 0 sends it as it is (about 95 image tokens, not 375).
# FOTOMATES_BOX_SIDE=480
# The crop: this share of the box's longer side added on every side...
# FOTOMATES_CROP_MARGIN=0.25
# ...then enlarged to this width in pixels (its shorter side never below FOTOMATES_MIN_SIDE).
# FOTOMATES_CROP_WIDTH=650
# A display whose box is narrower than this many photo pixels gets reason_code far:<width>; 0: off.
# FOTOMATES_FAR_PX=60
# With FOTOMATES_FEWSHOT=1: which reads get the example photos, third (the read after an unsure whole photo) or all.
# FOTOMATES_FEWSHOT_ON=third
# A black frame (answered BLANK with no model request): grey mean and standard deviation both below this.
# FOTOMATES_BLANK_MAX=5
# A near-black frame too: mean and standard deviation below FOTOMATES_BLANK_DIM and the 99th percentile
# of grey below FOTOMATES_BLANK_P99 (proposed 40; 0: off). A lit display keeps a photo out of it.
# FOTOMATES_BLANK_P99=0
# FOTOMATES_BLANK_DIM=20
# Correct a photo's light before reading it: auto (only photos with the flags below), always or never.
# FOTOMATES_ENHANCE=auto
# The image check flags that make auto correct a photo.
# FOTOMATES_ENHANCE_WHEN=is_low_contrast,is_dark,is_bright,has_glare
# How a photo is corrected: light (keeps colour) or gmm (grayscale denoise, glare, contrast, sharpen).
# FOTOMATES_ENHANCER=light
# Fewest digits a run must have to count as the reading, when the answer has no READING line.
# FOTOMATES_MIN_READING_DIGITS=6
# Most digits a reading may have; a longer one is not taken as a reading.
# FOTOMATES_MAX_READING_DIGITS=12

# ---------------------------------------------------------------------------------------
# Scoring: when a photo is rejected or flagged
# ---------------------------------------------------------------------------------------
# A photo whose score is under this must be retaken.
# FOTOMATES_RETAKE_SCORE=0.5
# A reading with this many digits or more gets score 0 (no meter shows that many).
# FOTOMATES_TOO_MANY_DIGITS=12
# Retake a photo whose chance of CLEAR is under this; 0 keeps QUALITY as information only.
# FOTOMATES_RETAKE_CLEAR=0
# Web page: a quality note is shown when the score is under this...
# FOTOMATES_QUALITY_SCORE=0.9
# ...or when the least certain digit is under this.
# FOTOMATES_QUALITY_DIGIT=0.95
# evaluation.py: the score at or above which a read counts as accepted.
# FOTOMATES_EVAL_SCORE=0.8

# ---------------------------------------------------------------------------------------
# Throughput: how many photos are read at once
# ---------------------------------------------------------------------------------------
# Most photos read at once when the server reports its slots (production value).
# FOTOMATES_IMAGE_WORKERS=24
# 1: every request is streamed, to measure the time to the first token and the generation time.
# FOTOMATES_STREAM=0
# 1: every fixed word before the image (instructions in the system message), so the server can cache it.
# FOTOMATES_PREFIX=0
# 1: send "cache_prompt": true with every request.
# FOTOMATES_CACHE_PROMPT=0
# Server slots the requests are pinned to (id_slot), e.g. 0-7; empty: the server chooses.
# FOTOMATES_SLOT_IDS=
# Photos sent per server slot.
# FOTOMATES_WORKERS_PER_SLOT=2
# Slot count assumed when the server's /slots endpoint does not answer (production value).
# FOTOMATES_SERVER_SLOTS=32
# Seconds to wait for the server's /slots answer.
# FOTOMATES_SLOTS_COUNT_TIMEOUT=5
# Times the client retries a failed request to the model server.
# FOTOMATES_API_RETRIES=2
# Seconds to keep waiting while the server says its model is still loading.
# FOTOMATES_MODEL_LOADING_WAIT=900
# Seconds between checks while the model is loading.
# FOTOMATES_MODEL_LOADING_POLL=15

# ---------------------------------------------------------------------------------------
# Image checks: what makes a photo blurry, dark, bright, noisy or glared (detect_quality.py)
# ---------------------------------------------------------------------------------------
# Sharpness (Laplacian variance) under this is blurry.
# FOTOMATES_BLUR_THRESHOLD=120
# Grey standard deviation under this is low contrast.
# FOTOMATES_LOW_CONTRAST_THRESHOLD=40
# Grey mean (0..255) under this is dark.
# FOTOMATES_DARK_THRESHOLD=85
# Grey mean (0..255) over this is bright.
# FOTOMATES_BRIGHT_THRESHOLD=200
# Noisy: sharpness above this...
# FOTOMATES_NOISE_MIN_VARIANCE=800
# ...that falls below this share of itself after a median filter.
# FOTOMATES_NOISE_RATIO=0.35
# Glare: pixels at least this bright (0..255)...
# FOTOMATES_GLARE_MIN_VALUE=235
# ...and at most this saturated (0..255)...
# FOTOMATES_GLARE_MAX_SATURATION=55
# ...covering this share of the photo...
# FOTOMATES_GLARE_FRACTION=0.025
# ...or one patch of them covering this share.
# FOTOMATES_GLARE_PATCH_FRACTION=0.012

# ---------------------------------------------------------------------------------------
# Batch: audit_readings.py
# ---------------------------------------------------------------------------------------
# The results database, relative to the code folder (--db overrides it).
# FOTOMATES_AUDIT_DB=audit_readings.sqlite3
# Times a failed photo is read again (after 2, 5 and 10 seconds) before it is saved as an error.
# FOTOMATES_PHOTO_RETRIES=3
# Photo share gone (a file cannot be read): every worker pauses and the folder is checked this often, in seconds...
# FOTOMATES_SHARE_POLL=15
# ...for at most this long; then the waiting photos are saved as errors.
# FOTOMATES_SHARE_WAIT=1800
# Files listed per group in the Word report; the CSV beside it lists them all.
# FOTOMATES_WORD_LIST_MAX=2000

# ---------------------------------------------------------------------------------------
# Web app: web_app.py (and docker-compose.yml)
# ---------------------------------------------------------------------------------------
# Address the web app listens on; 0.0.0.0 to reach it from other machines.
# FOTOMATES_HOST=127.0.0.1
# Port the web app listens on.
# FOTOMATES_PORT=8081
# Folder for uploaded runs and their results (default: web_runs next to the code).
# FOTOMATES_RUNS=web_runs
# Most photos in one upload.
# FOTOMATES_MAX_PHOTOS=1000
# Largest upload, in MB.
# FOTOMATES_MAX_UPLOAD_MB=5000
# Largest single photo read live, in MB.
# FOTOMATES_LIVE_MAX_MB=20
# Uploaded runs processed at the same time.
# FOTOMATES_JOB_WORKERS=1
# Rows per page on the audit page.
# FOTOMATES_AUDIT_PAGE_SIZE=100
# docker-compose.yml: the host port the container is published on.
# FOTOMATES_PUBLISH_PORT=8081
